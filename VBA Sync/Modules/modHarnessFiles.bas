    s = s & "                if (-not [XcDialog.Win32]::IsWindow($h)) { return $true }" & vbLf
    s = s & "                if (-not [XcDialog.Win32]::IsWindowVisible($h)) { return $true }" & vbLf
    s = s & "                Start-Sleep -Milliseconds 50" & vbLf
