    s = s & "                    [void]$state.ActiveDialogs.Remove($key)" & vbLf
    s = s & "                    [void]$state.DialogInfo.Remove($id)" & vbLf
    s = s & "                }" & vbLf
    s = s & "            }" & vbLf
    s = s & "" & vbLf
    s = s & "            # Externally-closed dialogs" & vbLf
    s = s & "            $toRemove = @()" & vbLf
    s = s & "            foreach ($key in @($state.ActiveDialogs.Keys)) {" & vbLf
    s = s & "                if (-not $stillActive.ContainsKey([int64]$key)) { $toRemove += $key }" & vbLf
    s = s & "            }" & vbLf
    s = s & "            foreach ($key in $toRemove) {" & vbLf
    s = s & "                $id = $state.ActiveDialogs[$key]" & vbLf
    s = s & "                [void]$state.ActiveDialogs.Remove($key)" & vbLf
    s = s & "                [void]$state.DialogInfo.Remove($id)" & vbLf
    s = s & "                Write-SessionEvent @{ t = 'dialog_closed_externally'; id = $id }" & vbLf
    s = s & "            }" & vbLf
    s = s & "" & vbLf
    s = s & "            # respond_dialog commands" & vbLf
    s = s & "            $cmds = Read-RespondCommands" & vbLf
    s = s & "            foreach ($cmd in $cmds) {" & vbLf
    s = s & "                Write-SessionEvent @{ t = 'command_ack'; id = $cmd.id; cmd = 'respond_dialog' }" & vbLf
    s = s & "                $dialogId = $cmd.dialog_id" & vbLf
    s = s & "                $info = $state.DialogInfo[$dialogId]" & vbLf
    s = s & "                if (-not $info) {" & vbLf
    s = s & "                    Write-SessionEvent @{ t = 'respond_failed'; id = $cmd.id; dialog_id = $dialogId; reason = 'unknown_or_closed_dialog' }" & vbLf
    s = s & "                    continue" & vbLf
    s = s & "                }" & vbLf
    s = s & "                $closed = Send-DialogClick -dialogInfo $info -buttonLabel $cmd.button" & vbLf
    s = s & "                if ($closed) {" & vbLf
    s = s & "                    Write-SessionEvent @{ t = 'dialog_dismissed'; id = $cmd.id; dialog_id = $dialogId; button = $cmd.button }" & vbLf
    s = s & "                    [void]$state.ActiveDialogs.Remove([int64]$info.Hwnd)" & vbLf
    s = s & "                    [void]$state.DialogInfo.Remove($dialogId)" & vbLf
    s = s & "                } else {" & vbLf
    s = s & "                    Write-SessionEvent @{ t = 'respond_failed'; id = $cmd.id; dialog_id = $dialogId; reason = 'dialog_did_not_close' }" & vbLf
    s = s & "                }" & vbLf
    s = s & "            }" & vbLf
    s = s & "" & vbLf
    s = s & "            Start-Sleep -Milliseconds $state.PollMs" & vbLf
    s = s & "        }" & vbLf
    s = s & "    })" & vbLf
    s = s & "" & vbLf
    s = s & "    $handle = $ps.BeginInvoke()" & vbLf
    s = s & "    return [pscustomobject]@{" & vbLf
    s = s & "        State      = $state" & vbLf
    s = s & "        PowerShell = $ps" & vbLf
    s = s & "        Handle     = $handle" & vbLf
    s = s & "        Runspace   = $rs" & vbLf
    s = s & "    }" & vbLf
    s = s & "}" & vbLf
    s = s & "" & vbLf
    s = s & "function Stop-SessionDialogWatcher($Watcher) {" & vbLf
    s = s & "    if (-not $Watcher) { return }" & vbLf
    s = s & "    $Watcher.State.Stop = $true" & vbLf
    s = s & "    try { [void]$Watcher.PowerShell.EndInvoke($Watcher.Handle) } catch {}" & vbLf
    s = s & "    try { $Watcher.PowerShell.Dispose() } catch {}" & vbLf
    s = s & "    try { $Watcher.Runspace.Close() } catch {}" & vbLf
    s = s & "}" & vbLf
    GetSessionDialogWatcherPs1 = s
End Function

' Source: excel-control\capture.ps1
Public Function GetCapturePs1() As String
    Dim s As String
    s = s & "# Screenshot helpers for excel-control." & vbLf
    s = s & "#" & vbLf
    s = s & "# Save-WindowImage  → Win32 PrintWindow (works on obscured / hidden-behind windows)" & vbLf
    s = s & "# Save-ScreenImage  → System.Drawing CopyFromScreen of a screen rectangle" & vbLf
    s = s & "#" & vbLf
    s = s & "# Both write a PNG file and return the path." & vbLf
    s = s & "" & vbLf
    s = s & "Add-Type -AssemblyName System.Drawing -ErrorAction SilentlyContinue" & vbLf
    s = s & "" & vbLf
    s = s & "if (-not ([System.Management.Automation.PSTypeName]'XcCapture.Win32').Type) {" & vbLf
    s = s & "  Add-Type @""" & vbLf
    s = s & "using System;" & vbLf
    s = s & "using System.Runtime.InteropServices;" & vbLf
    s = s & "" & vbLf
    s = s & "namespace XcCapture {" & vbLf
    s = s & "  [StructLayout(LayoutKind.Sequential)]" & vbLf
    s = s & "  public struct RECT { public int Left; public int Top; public int Right; public int Bottom; }" & vbLf
    s = s & "" & vbLf
    s = s & "  public static class Win32 {" & vbLf
    s = s & "    [DllImport(""user32.dll"")] public static extern bool GetWindowRect(IntPtr hWnd, out RECT lpRect);" & vbLf
    s = s & "    [DllImport(""user32.dll"")] public static extern bool PrintWindow(IntPtr hWnd, IntPtr hdcBlt, uint nFlags);" & vbLf
    s = s & "    [DllImport(""user32.dll"")] public static extern bool IsWindow(IntPtr hWnd);" & vbLf
    s = s & "    public const uint PW_CLIENTONLY     = 0x1;" & vbLf
    s = s & "    public const uint PW_RENDERFULLCONTENT = 0x2;  // composited capture; Win 8.1+" & vbLf
    s = s & "  }" & vbLf
    s = s & "}" & vbLf
    s = s & """@" & vbLf
    s = s & "}" & vbLf
    s = s & "" & vbLf
    s = s & "# Captures a window by HWND, including content obscured by other windows." & vbLf
    s = s & "# Returns the path on success; throws on invalid HWND or capture failure." & vbLf
    s = s & "function Save-WindowImage {" & vbLf
    s = s & "    param(" & vbLf
    s = s & "        [Parameter(Mandatory=$true)] [int64]$Hwnd," & vbLf
    s = s & "        [Parameter(Mandatory=$true)] [string]$Path" & vbLf
    s = s & "    )" & vbLf
    s = s & "    $h = [IntPtr]$Hwnd" & vbLf
    s = s & "    if (-not [XcCapture.Win32]::IsWindow($h)) {" & vbLf
    s = s & "        throw ""Save-WindowImage: not a valid HWND ($Hwnd)""" & vbLf
    s = s & "    }" & vbLf
    s = s & "    $rect = New-Object XcCapture.RECT" & vbLf
    s = s & "    [void][XcCapture.Win32]::GetWindowRect($h, [ref]$rect)" & vbLf
    s = s & "    $w = $rect.Right - $rect.Left" & vbLf
    s = s & "    $hgt = $rect.Bottom - $rect.Top" & vbLf
    s = s & "    if ($w -le 0 -or $hgt -le 0) { throw ""Save-WindowImage: window has zero dimensions"" }" & vbLf
    s = s & "" & vbLf
    s = s & "    $bmp = New-Object System.Drawing.Bitmap $w, $hgt" & vbLf
    s = s & "    $g   = [System.Drawing.Graphics]::FromImage($bmp)" & vbLf
    s = s & "    $hdc = $g.GetHdc()" & vbLf
    s = s & "    try {" & vbLf
    s = s & "        # PW_RENDERFULLCONTENT (0x2) needed for composited content (Edge," & vbLf
    s = s & "        # Chromium-host controls). Falls back to standard if unsupported." & vbLf
    s = s & "        [void][XcCapture.Win32]::PrintWindow($h, $hdc, [XcCapture.Win32]::PW_RENDERFULLCONTENT)" & vbLf
    s = s & "    } finally {" & vbLf
    s = s & "        $g.ReleaseHdc($hdc)" & vbLf
    s = s & "        $g.Dispose()" & vbLf
    s = s & "    }" & vbLf
    s = s & "    $bmp.Save($Path, [System.Drawing.Imaging.ImageFormat]::Png)" & vbLf
    s = s & "    $bmp.Dispose()" & vbLf
    s = s & "    return $Path" & vbLf
    s = s & "}" & vbLf
    s = s & "" & vbLf
    s = s & "# Captures a screen rectangle (or full virtual screen if -Rect not supplied)." & vbLf
    s = s & "# Returns the path. Use for the main Excel window or specific monitor regions." & vbLf
    s = s & "function Save-ScreenImage {" & vbLf
    s = s & "    param(" & vbLf
    s = s & "        [Parameter(Mandatory=$true)] [string]$Path," & vbLf
    s = s & "        [int]$X      = -1," & vbLf
    s = s & "        [int]$Y      = -1," & vbLf
    s = s & "        [int]$Width  = -1," & vbLf
    s = s & "        [int]$Height = -1" & vbLf
    s = s & "    )" & vbLf
    s = s & "    if ($X -lt 0) {" & vbLf
    s = s & "        Add-Type -AssemblyName System.Windows.Forms" & vbLf
    s = s & "        $vs = [System.Windows.Forms.SystemInformation]::VirtualScreen" & vbLf
    s = s & "        $X = $vs.X; $Y = $vs.Y; $Width = $vs.Width; $Height = $vs.Height" & vbLf
    s = s & "    }" & vbLf
    s = s & "    $bmp = New-Object System.Drawing.Bitmap $Width, $Height" & vbLf
    s = s & "    $g   = [System.Drawing.Graphics]::FromImage($bmp)" & vbLf
    s = s & "    $g.CopyFromScreen($X, $Y, 0, 0, (New-Object System.Drawing.Size($Width, $Height)))" & vbLf
    s = s & "    $g.Dispose()" & vbLf
    s = s & "    $bmp.Save($Path, [System.Drawing.Imaging.ImageFormat]::Png)" & vbLf
    s = s & "    $bmp.Dispose()" & vbLf
    s = s & "    return $Path" & vbLf
    s = s & "}" & vbLf
    GetCapturePs1 = s
End Function

' Source: excel-control\tools\INTERFACE.md
Public Function GetInterfaceMd() As String
    Dim s As String
    s = s & "# excel-control — agent interface" & vbLf
    s = s & "" & vbLf
    s = s & "A long-running PowerShell session holds an Excel instance open and" & vbLf
    s = s & "exchanges events with you (the agent) over append-only JSONL files." & vbLf
    s = s & "You send commands by appending to `commands.jsonl`; the harness writes" & vbLf
    s = s & "events to `events.jsonl`." & vbLf
    s = s & "" & vbLf
    s = s & "## Quickstart (Claude Code)" & vbLf
    s = s & "" & vbLf
    s = s & "```" & vbLf
    s = s & "# Start a session in the background (headless Excel by default)" & vbLf
    s = s & "Bash run_in_background=true: pwsh tools/start-session.ps1 -Workbook X.xlsm -SessionId s1" & vbLf
    s = s & "" & vbLf
    s = s & "# OR visible Excel (user can watch the agent work; worksheet" & vbLf
    s = s & "# screenshots become meaningful)" & vbLf
    s = s & "Bash run_in_background=true: pwsh tools/start-session.ps1 -Workbook X.xlsm -SessionId s1 -Visible" & vbLf
    s = s & "" & vbLf
    s = s & "# Tail events.jsonl — each new line is a push notification" & vbLf
    s = s & "Monitor: tools/sessions/s1/events.jsonl" & vbLf
    s = s & "" & vbLf
    s = s & "# Send commands by appending to commands.jsonl" & vbLf
    s = s & "Write/Edit append: tools/sessions/s1/commands.jsonl" & vbLf
    s = s & "   {""id"":""c1"",""cmd"":""run_macro"",""name"":""BuildReport""}" & vbLf
    s = s & "" & vbLf
    s = s & "# End the session" & vbLf
