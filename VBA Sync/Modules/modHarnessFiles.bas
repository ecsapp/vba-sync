    s = s & "- ⚠️  **Foreground focus** — if `-Visible` is set, agent operations may steal focus from windows the user is working in" & vbLf
    s = s & "" & vbLf
    s = s & "If concurrent use is essential, prefer `-Visible` so the user can SEE" & vbLf
    s = s & "what the agent is doing instead of being surprised by stray dialogs." & vbLf
    s = s & "" & vbLf
    s = s & "### Known limitations (deferred)" & vbLf
    s = s & "" & vbLf
    s = s & "- **`Debug.Print` capture** — in headless Excel COM, `Debug.Print`" & vbLf
    s = s & "  output doesn't surface in `VBE.Windows(""Immediate"").CodePane`. The" & vbLf
    s = s & "  capture code is in place but yields no events in headless mode." & vbLf
    s = s & "  Use a custom logger that writes to a file if you need runtime output." & vbLf
    s = s & "- **UserForm field introspection** — `Controls(name).Value` for a" & vbLf
    s = s & "  running modal UserForm isn't reachable from outside the VBA runtime." & vbLf
    s = s & "  Field-level read/write isn't supported. `respond_dialog` fires the" & vbLf
    s = s & "  form's Default button via VK_RETURN; for input forms, build a VBA" & vbLf
    s = s & "  wrapper that pre-fills them before showing." & vbLf
    s = s & "- **`.frx` non-determinism** — Excel's UserForm binary writer is" & vbLf
    s = s & "  non-deterministic. Separate work item being tracked outside this" & vbLf
    s = s & "  harness." & vbLf
    GetInterfaceMd = s
End Function

' Source: excel-control\tools\clsAssert.cls
Public Function GetClsAssertCls() As String
    Dim s As String
    s = s & "VERSION 1.0 CLASS" & vbLf
    s = s & "BEGIN" & vbLf
    s = s & "  MultiUse = -1  'True" & vbLf
    s = s & "END" & vbLf
    s = s & "Attribute VB_Name = ""Assert""" & vbLf
    s = s & "Attribute VB_GlobalNameSpace = False" & vbLf
    s = s & "Attribute VB_Creatable = True" & vbLf
    s = s & "Attribute VB_PredeclaredId = True" & vbLf
    s = s & "Attribute VB_Exposed = False" & vbLf
    s = s & "Option Explicit" & vbLf
    s = s & "" & vbLf
    s = s & "' Minimal assertion library for excel-control run_tests." & vbLf
    s = s & "'" & vbLf
    s = s & "' Usage in a Test_* Sub:" & vbLf
    s = s & "'   Public Sub Test_Sales_Total()" & vbLf
    s = s & "'       Assert.AreEqual 100, ComputeTotal(50, 50)" & vbLf
    s = s & "'       Assert.IsTrue ComputeTotal(0, 0) >= 0" & vbLf
    s = s & "'   End Sub" & vbLf
    s = s & "'" & vbLf
    s = s & "' On failure, raises a vbObjectError-based error so the session host's" & vbLf
    s = s & "' Application.Run catches it and emits a `test_result` with status=fail." & vbLf
    s = s & "" & vbLf
    s = s & "Private Const ASSERT_ERR As Long = vbObjectError + 9001" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub AreEqual(ByVal expected As Variant, ByVal actual As Variant, _" & vbLf
    s = s & "                    Optional ByVal message As String = """")" & vbLf
    s = s & "    Dim ok As Boolean" & vbLf
    s = s & "    If IsObject(expected) Or IsObject(actual) Then" & vbLf
    s = s & "        ok = (ObjPtr(expected) = ObjPtr(actual))" & vbLf
    s = s & "    Else" & vbLf
    s = s & "        ok = (expected = actual)" & vbLf
    s = s & "    End If" & vbLf
    s = s & "    If Not ok Then" & vbLf
    s = s & "        Dim msg As String" & vbLf
    s = s & "        msg = ""AreEqual failed: expected="" & CStr(expected) & "" actual="" & CStr(actual)" & vbLf
    s = s & "        If Len(message) > 0 Then msg = msg & "" ("" & message & "")""" & vbLf
    s = s & "        Err.Raise ASSERT_ERR, ""Assert.AreEqual"", msg" & vbLf
    s = s & "    End If" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub IsTrue(ByVal expr As Boolean, Optional ByVal message As String = """")" & vbLf
    s = s & "    If Not expr Then" & vbLf
    s = s & "        Dim msg As String" & vbLf
    s = s & "        msg = ""IsTrue failed""" & vbLf
    s = s & "        If Len(message) > 0 Then msg = msg & "": "" & message" & vbLf
    s = s & "        Err.Raise ASSERT_ERR, ""Assert.IsTrue"", msg" & vbLf
    s = s & "    End If" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub IsFalse(ByVal expr As Boolean, Optional ByVal message As String = """")" & vbLf
    s = s & "    If expr Then" & vbLf
    s = s & "        Dim msg As String" & vbLf
    s = s & "        msg = ""IsFalse failed""" & vbLf
    s = s & "        If Len(message) > 0 Then msg = msg & "": "" & message" & vbLf
    s = s & "        Err.Raise ASSERT_ERR, ""Assert.IsFalse"", msg" & vbLf
    s = s & "    End If" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub IsNothing(ByVal obj As Object, Optional ByVal message As String = """")" & vbLf
    s = s & "    If Not obj Is Nothing Then" & vbLf
    s = s & "        Dim msg As String" & vbLf
    s = s & "        msg = ""IsNothing failed: object is not Nothing""" & vbLf
    s = s & "        If Len(message) > 0 Then msg = msg & "" ("" & message & "")""" & vbLf
    s = s & "        Err.Raise ASSERT_ERR, ""Assert.IsNothing"", msg" & vbLf
    s = s & "    End If" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub Fail(Optional ByVal message As String = """")" & vbLf
    s = s & "    Dim msg As String" & vbLf
    s = s & "    msg = ""Fail()""" & vbLf
    s = s & "    If Len(message) > 0 Then msg = msg & "": "" & message" & vbLf
    s = s & "    Err.Raise ASSERT_ERR, ""Assert.Fail"", msg" & vbLf
    s = s & "End Sub" & vbLf
    GetClsAssertCls = s
End Function

