    s = s & "            return $false" & vbLf
    s = s & "        }" & vbLf
    s = s & "" & vbLf
    s = s & "        function Write-SessionEvent([hashtable]$ev) {" & vbLf
    s = s & "            $line = $ev | ConvertTo-Json -Compress -Depth 10" & vbLf
    s = s & "            for ($i = 0; $i -lt 5; $i++) {" & vbLf
