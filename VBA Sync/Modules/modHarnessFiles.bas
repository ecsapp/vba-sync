    s = s & "            try {" & vbLf
    s = s & "                $p = $cmd.path" & vbLf
    s = s & "                if (-not $p) { throw ""open_workbook requires path"" }" & vbLf
    s = s & "                $resolved = (Resolve-Path -LiteralPath $p).Path" & vbLf
    s = s & "                $newWb = $Xl.Workbooks.Open($resolved, [Type]::Missing, $false, [Type]::Missing, [Type]::Missing, [Type]::Missing, $true)" & vbLf
    s = s & "                Write-EventLine @{ t = 'workbook_opened'; id = $cmd.id; name = $newWb.Name; path = $resolved }" & vbLf
    s = s & "            } catch {" & vbLf
    s = s & "                Write-EventLine @{ t = 'open_failed'; id = $cmd.id; error = $_.Exception.Message }" & vbLf
    s = s & "            }" & vbLf
    s = s & "        }" & vbLf
    s = s & "        'close_workbook' {" & vbLf
    s = s & "            try {" & vbLf
    s = s & "                $name = $cmd.name" & vbLf
    s = s & "                if (-not $name) { throw ""close_workbook requires name (workbook name)"" }" & vbLf
    s = s & "                $target = $Xl.Workbooks.Item($name)" & vbLf
    s = s & "                $target.Close([bool]$cmd.save)" & vbLf
    s = s & "                Write-EventLine @{ t = 'workbook_closed_cmd'; id = $cmd.id; name = $name }" & vbLf
    s = s & "            } catch {" & vbLf
    s = s & "                Write-EventLine @{ t = 'close_workbook_failed'; id = $cmd.id; error = $_.Exception.Message }" & vbLf
    s = s & "            }" & vbLf
    s = s & "        }" & vbLf
    s = s & "        'close' {" & vbLf
    s = s & "            Write-EventLine @{ t = 'closing'; id = $cmd.id }" & vbLf
    s = s & "            $script:Stop = $true" & vbLf
    s = s & "        }" & vbLf
    s = s & "        default {" & vbLf
    s = s & "            Write-EventLine @{ t = 'unknown_command'; id = $cmd.id; cmd = $cmd.cmd }" & vbLf
    s = s & "        }" & vbLf
    s = s & "    }" & vbLf
    s = s & "}" & vbLf
    s = s & "" & vbLf
    s = s & "# ---------- main ----------" & vbLf
    s = s & "" & vbLf
    s = s & "$resolvedWb = (Resolve-Path -LiteralPath $Workbook).Path" & vbLf
    s = s & "$xl = New-Object -ComObject Excel.Application" & vbLf
    s = s & "$xl.Visible = [bool]$Visible" & vbLf
    s = s & "$xl.DisplayAlerts = $false" & vbLf
    s = s & "$xl.AskToUpdateLinks = $false" & vbLf
    s = s & "# Low = let macros run (default ForceDisable would block xl.Run)" & vbLf
    s = s & "$xl.AutomationSecurity = 1" & vbLf
    s = s & "$wb = $null" & vbLf
    s = s & "" & vbLf
    s = s & "try {" & vbLf
    s = s & "    # IgnoreReadOnlyRecommended=True so workbooks with that flag don't open RO." & vbLf
    s = s & "    $wb = $xl.Workbooks.Open($resolvedWb, [Type]::Missing, $false, [Type]::Missing," & vbLf
    s = s & "                             [Type]::Missing, [Type]::Missing, $true)" & vbLf
    s = s & "" & vbLf
    s = s & "    Save-State 'ready'" & vbLf
    s = s & "    Write-EventLine @{ t = 'started'; pid = $PID; workbook = $resolvedWb; session_id = $SessionId; visible = [bool]$Visible }" & vbLf
    s = s & "    Write-Host ""Session $SessionId started (pid=$PID, workbook=$resolvedWb, visible=$([bool]$Visible))"" -ForegroundColor Cyan" & vbLf
    s = s & "" & vbLf
    s = s & "    # Determine Excel's PID (not our $PID) so the watcher targets the right process." & vbLf
    s = s & "    # Recorded in state.json so tests / cleanup scripts can identify which" & vbLf
    s = s & "    # EXCEL.EXE belongs to this session — never blanket-kill all Excel." & vbLf
    s = s & "    $excelPid = [uint32]0" & vbLf
    s = s & "    [XcSession.Win32]::GetWindowThreadProcessId([IntPtr]$xl.Hwnd, [ref]$excelPid) | Out-Null" & vbLf
    s = s & "    $script:ExcelPid = [int]$excelPid" & vbLf
    s = s & "    Save-State 'ready'  # re-save now that we know excel_pid" & vbLf
    s = s & "" & vbLf
    s = s & "    $watcher = Start-SessionDialogWatcher `" & vbLf
    s = s & "        -ProcessId    $excelPid `" & vbLf
    s = s & "        -EventsFile   $eventsFile `" & vbLf
    s = s & "        -CommandsFile $commandsFile `" & vbLf
    s = s & "        -CapturesDir  $capturesDir" & vbLf
    s = s & "    $script:Watcher     = $watcher" & vbLf
    s = s & "    $script:CapturesDir = $capturesDir" & vbLf
    s = s & "    $script:SessionDir  = $sessionDir" & vbLf
    s = s & "" & vbLf
    s = s & "    while (-not $script:Stop) {" & vbLf
    s = s & "        $cmds = Read-NewCommands" & vbLf
    s = s & "        foreach ($entry in $cmds) {" & vbLf
    s = s & "            $cmd = $entry.obj" & vbLf
    s = s & "            # respond_dialog is owned by the watcher runspace — skip in main" & vbLf
    s = s & "            if ($cmd.cmd -eq 'respond_dialog') { continue }" & vbLf
    s = s & "            Write-EventLine @{ t = 'command_ack'; id = $cmd.id; cmd = $cmd.cmd }" & vbLf
    s = s & "            Save-State 'busy'" & vbLf
    s = s & "            Invoke-SessionCommand -Xl $xl -Wb $wb -cmd $cmd" & vbLf
    s = s & "            Save-State 'ready'" & vbLf
    s = s & "            if ($script:Stop) { break }" & vbLf
    s = s & "        }" & vbLf
    s = s & "        Save-State 'ready'" & vbLf
    s = s & "        if (-not $script:Stop) { Start-Sleep -Milliseconds $PollMs }" & vbLf
    s = s & "    }" & vbLf
    s = s & "}" & vbLf
    s = s & "catch {" & vbLf
    s = s & "    Write-EventLine @{ t = 'session_error'; error = $_.Exception.Message; stack = $_.ScriptStackTrace }" & vbLf
    s = s & "    Save-State 'crashed'" & vbLf
    s = s & "    Write-Host ""Session $SessionId crashed: $($_.Exception.Message)"" -ForegroundColor Red" & vbLf
    s = s & "}" & vbLf
    s = s & "finally {" & vbLf
    s = s & "    if ($watcher) { try { Stop-SessionDialogWatcher $watcher } catch {} }" & vbLf
    s = s & "    try { if ($wb) { $wb.Close($false) } } catch {}" & vbLf
    s = s & "    try { $xl.Quit() } catch {}" & vbLf
    s = s & "    try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($xl) | Out-Null } catch {}" & vbLf
    s = s & "    [GC]::Collect(); [GC]::WaitForPendingFinalizers()" & vbLf
    s = s & "    Save-State 'closed'" & vbLf
    s = s & "    Write-EventLine @{ t = 'closed' }" & vbLf
    s = s & "    Write-Host ""Session $SessionId closed"" -ForegroundColor Cyan" & vbLf
    s = s & "}" & vbLf
    GetStartSessionPs1 = s
End Function

