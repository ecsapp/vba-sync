Public Function GetSkillMd() As String
    Dim s As String
    s = s & "---" & vbLf
    s = s & "name: excel-control" & vbLf
    s = s & "description: Drive this Excel workbook end-to-end — run macros, read/write cells, handle dialogs and runtime errors, write and run a VBA test suite. Use whenever the user wants to execute, inspect, or interact with the workbook beyond static source editing. Reference at tools/INTERFACE.md." & vbLf
    s = s & "---" & vbLf
    s = s & "" & vbLf
    s = s & "# excel-control — agent guide" & vbLf
    s = s & "" & vbLf
    s = s & "This workbook ships with a PowerShell session harness that lets you" & vbLf
    s = s & "drive Excel programmatically. Long-running PS process holds a COM" & vbLf
    s = s & "instance open; you communicate via two append-only JSONL files:" & vbLf
    s = s & "" & vbLf
    s = s & "- `tools/sessions/<id>/commands.jsonl` — you append, harness consumes" & vbLf
    s = s & "- `tools/sessions/<id>/events.jsonl` — harness appends, you watch" & vbLf
    s = s & "" & vbLf
    s = s & "`tools/INTERFACE.md` is the full API reference. This file is the guide:" & vbLf
    s = s & "how to do common things." & vbLf
    s = s & "" & vbLf
    s = s & "## Quickstart" & vbLf
    s = s & "" & vbLf
    s = s & "```" & vbLf
    s = s & "# headless (default — Excel runs invisibly)" & vbLf
    s = s & "Bash run_in_background=true: pwsh tools/start-session.ps1 -Workbook X.xlsm -SessionId s1" & vbLf
    s = s & "" & vbLf
    s = s & "# visible (Excel on the desktop — user sees what the agent does;" & vbLf
    s = s & "# screenshots of worksheets become meaningful instead of mostly empty)" & vbLf
    s = s & "Bash run_in_background=true: pwsh tools/start-session.ps1 -Workbook X.xlsm -SessionId s1 -Visible" & vbLf
    s = s & "" & vbLf
    s = s & "Monitor: tools/sessions/s1/events.jsonl     ← push notifications, one per new line" & vbLf
    s = s & "Write/Edit append: tools/sessions/s1/commands.jsonl" & vbLf
    s = s & "" & vbLf
    s = s & "# end the session:" & vbLf
    s = s & "   {""id"":""cN"",""cmd"":""close""}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "**Concurrent Excel use**: the session creates a separate `EXCEL.EXE`" & vbLf
    s = s & "process. It's safe to run alongside the user's interactive Excel" & vbLf
    s = s & "PROVIDED:" & vbLf
    s = s & "- Don't open the same workbook in both (file-lock conflict)" & vbLf
    s = s & "- Be aware that MsgBoxes / runtime-error dialogs from the harness POP" & vbLf
    s = s & "  ON THE USER'S DESKTOP (the watcher auto-dismisses them fast, but a" & vbLf
    s = s & "  user click can race the watcher)" & vbLf
    s = s & "- With `-Visible`, agent operations may steal foreground focus" & vbLf
    s = s & "" & vbLf
    s = s & "Every command needs an `id` (any unique string per session — typically `c1`," & vbLf
    s = s & "`c2`, …) and a `cmd`. You get one `command_ack` event per command, then the" & vbLf
    s = s & "result event(s)." & vbLf
    s = s & "" & vbLf
    s = s & "## Common workflows" & vbLf
    s = s & "" & vbLf
    s = s & "### Run a macro with no dialogs expected" & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "// commands.jsonl:" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""run_macro"",""name"":""BuildReport"",""args"":[2026,""Q1""]}" & vbLf
    s = s & "" & vbLf
    s = s & "// events.jsonl:" & vbLf
    s = s & "{""t"":""command_ack"",""id"":""c1"",""cmd"":""run_macro""}" & vbLf
    s = s & "{""t"":""macro_completed"",""id"":""c1"",""name"":""BuildReport"",""result"":1247,""duration_ms"":4210}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "### Run a macro that pops a dialog" & vbLf
    s = s & "" & vbLf
    s = s & "The dialog watcher reports every modal as an event with text, buttons," & vbLf
    s = s & "and a screenshot. Decide which button, send `respond_dialog`, the" & vbLf
    s = s & "macro continues." & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""run_macro"",""name"":""RefreshFromDB""}" & vbLf
    s = s & "// →" & vbLf
    s = s & "{""t"":""command_ack"",""id"":""c1"",""cmd"":""run_macro""}" & vbLf
    s = s & "{""t"":""dialog_appeared"",""id"":""d1"",""title"":""Microsoft Excel"",""text"":""Overwrite existing data?"",""buttons"":[""Yes"",""No"",""Cancel""],""screenshot"":""tools/sessions/s1/captures/d1.png""}" & vbLf
    s = s & "// you read the screenshot if needed, then:" & vbLf
    s = s & "{""id"":""c2"",""cmd"":""respond_dialog"",""dialog_id"":""d1"",""button"":""Yes""}" & vbLf
    s = s & "// →" & vbLf
    s = s & "{""t"":""command_ack"",""id"":""c2"",""cmd"":""respond_dialog""}" & vbLf
    s = s & "{""t"":""dialog_dismissed"",""id"":""c2"",""dialog_id"":""d1"",""button"":""Yes""}" & vbLf
    s = s & "{""t"":""macro_completed"",""id"":""c1"",""name"":""RefreshFromDB"",""result"":null}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "### Diagnose and fix a runtime error" & vbLf
    s = s & "" & vbLf
    s = s & "When a macro hits an unhandled error, Excel's ""Microsoft Visual Basic""" & vbLf
    s = s & "dialog appears. The watcher auto-dismisses it (End) and emits a" & vbLf
    s = s & "structured `runtime_error` event with the number and description." & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""run_macro"",""name"":""BuildReport""}" & vbLf
    s = s & "// →" & vbLf
    s = s & "{""t"":""runtime_error"",""id"":""d1"",""number"":9,""description"":""Subscript out of range"",""screenshot"":""...""}" & vbLf
    s = s & "{""t"":""macro_failed"",""id"":""c1"",""name"":""BuildReport"",""error"":""...""}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "Fix loop:" & vbLf
    s = s & "1. Read the offending module to find the error site (you may need to" & vbLf
    s = s & "   `list_macros` first to know which modules exist, or `sync_vba` from" & vbLf
    s = s & "   your source-on-disk and then `compile_check`)." & vbLf
    s = s & "2. Edit the `.bas` / `.cls` on disk." & vbLf
    s = s & "3. `sync_vba` to push the fix into the running Excel." & vbLf
    s = s & "4. `compile_check` — confirm no parse errors." & vbLf
    s = s & "5. `run_macro` again." & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "{""id"":""c2"",""cmd"":""sync_vba"",""source_dir"":"".""}" & vbLf
    s = s & "// → {""t"":""sync_completed"",""id"":""c2"",""imported"":[""modSales""],""removed"":[]}" & vbLf
    s = s & "" & vbLf
    s = s & "{""id"":""c3"",""cmd"":""compile_check""}" & vbLf
    s = s & "// → {""t"":""compile_result"",""id"":""c3"",""ok"":true}" & vbLf
    s = s & "" & vbLf
    s = s & "{""id"":""c4"",""cmd"":""run_macro"",""name"":""BuildReport""}" & vbLf
    s = s & "// → {""t"":""macro_completed"",""id"":""c4"",""result"":1247}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "### Write and run a test suite" & vbLf
    s = s & "" & vbLf
    s = s & "The harness has a discover-and-run convention for VBA tests:" & vbLf
    s = s & "" & vbLf
    s = s & "- Any `Public Sub Test_<Name>()` in any module gets discovered by `run_tests`." & vbLf
    s = s & "- A test **passes** if it runs to completion without raising an error." & vbLf
    s = s & "- A test **fails** if it raises any error (via `Err.Raise` or an" & vbLf
    s = s & "  unhandled runtime error)." & vbLf
    s = s & "" & vbLf
    s = s & "The shipped `tools/clsAssert.cls` is a minimal assertion library. Import" & vbLf
    s = s & "it into your workbook (via `sync_vba`) and use its `Assert.AreEqual`," & vbLf
    s = s & "`Assert.IsTrue`, `Assert.IsFalse`, `Assert.IsNothing`, `Assert.Fail`" & vbLf
    s = s & "methods. Each raises a vbObjectError on mismatch, which the test" & vbLf
    s = s & "runner catches." & vbLf
    s = s & "" & vbLf
    s = s & "Example test module (drop this in `<your-repo>/Modules/modSalesTests.bas`):" & vbLf
    s = s & "" & vbLf
    s = s & "```vba" & vbLf
    s = s & "Attribute VB_Name = ""modSalesTests""" & vbLf
    s = s & "Option Explicit" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub Test_Sales_BasicTotal()" & vbLf
    s = s & "    Dim total As Long" & vbLf
    s = s & "    total = ComputeTotal(50, 50)" & vbLf
    s = s & "    Assert.AreEqual 100, total" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub Test_Sales_RejectsNegatives()" & vbLf
    s = s & "    On Error Resume Next" & vbLf
    s = s & "    ComputeTotal -1, 0" & vbLf
    s = s & "    If Err.Number = 0 Then Assert.Fail ""expected error on negative qty""" & vbLf
    s = s & "    Err.Clear" & vbLf
    s = s & "    On Error GoTo 0" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "" & vbLf
    s = s & "Public Sub Test_Sales_HappyPath_Refresh()" & vbLf
    s = s & "    Refresh_Sales_Sheet" & vbLf
    s = s & "    Assert.IsTrue Range(""Summary!B12"").Value > 0, ""expected non-zero in B12""" & vbLf
    s = s & "End Sub" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "To run them:" & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "// Sync your source (includes clsAssert.cls + your test modules):" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""sync_vba"",""source_dir"":"".""}" & vbLf
    s = s & "// → {""t"":""sync_completed"",""id"":""c1"",""imported"":[""clsAssert"",""modSalesTests"",...],""removed"":[]}" & vbLf
    s = s & "" & vbLf
    s = s & "// Optional: compile first to catch typos" & vbLf
    s = s & "{""id"":""c2"",""cmd"":""compile_check""}" & vbLf
    s = s & "// → {""t"":""compile_result"",""id"":""c2"",""ok"":true}" & vbLf
    s = s & "" & vbLf
    s = s & "// Run everything matching Test_Sales_*" & vbLf
    s = s & "{""id"":""c3"",""cmd"":""run_tests"",""filter"":""^Test_Sales_""}" & vbLf
    s = s & "// →" & vbLf
    s = s & "{""t"":""test_result"",""module"":""modSalesTests"",""name"":""Test_Sales_BasicTotal"",""status"":""pass"",""duration_ms"":12}" & vbLf
    s = s & "{""t"":""test_result"",""module"":""modSalesTests"",""name"":""Test_Sales_RejectsNegatives"",""status"":""pass"",""duration_ms"":8}" & vbLf
    s = s & "{""t"":""test_result"",""module"":""modSalesTests"",""name"":""Test_Sales_HappyPath_Refresh"",""status"":""fail"",""duration_ms"":420,""error"":{""message"":""AreEqual failed: expected=100 actual=0"",""hresult"":-2147221503}}" & vbLf
    s = s & "{""t"":""tests_completed"",""id"":""c3"",""total"":3,""passed"":2,""failed"":1,""duration_ms"":520}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "Interpreting:" & vbLf
    s = s & "- `tests_completed.passed`/`failed` is your summary" & vbLf
    s = s & "- Each `test_result.status` is `pass` or `fail` (no separate `error` category;" & vbLf
    s = s & "  unhandled errors look the same as failed assertions to the runner)" & vbLf
    s = s & "- `test_result.error.message` carries the assertion message (or the" & vbLf
    s = s & "  VBA error description if it was an unhandled error)" & vbLf
    s = s & "" & vbLf
    s = s & "### Inspect a workbook you've never seen" & vbLf
    s = s & "" & vbLf
    s = s & "When meeting an unfamiliar workbook, three commands give you the lay of" & vbLf
    s = s & "the land:" & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""get_workbook_info""}" & vbLf
    s = s & "// → {""t"":""workbook_info"",""id"":""c1"",""info"":{""name"":""X.xlsm"",""size_bytes"":118000," & vbLf
    s = s & "//      ""sheet_count"":12,""table_count"":4,""has_vba"":true,""has_pivots"":true," & vbLf
    s = s & "//      ""has_connections"":true,""vba_protection"":0,""last_author"":""alice""}}" & vbLf
    s = s & "" & vbLf
    s = s & "{""id"":""c2"",""cmd"":""list_sheets""}" & vbLf
    s = s & "// → {""t"":""sheets_listed"",""id"":""c2"",""sheets"":[" & vbLf
    s = s & "//      {""name"":""Inputs"",""used_range"":""A1:Z48"",""tables"":[""tblScenarios""]}," & vbLf
    s = s & "//      {""name"":""Calc"",""used_range"":""A1:CC2400"",""hidden"":true,""protected"":true}," & vbLf
    s = s & "//      ...]}" & vbLf
    s = s & "" & vbLf
    s = s & "{""id"":""c3"",""cmd"":""list_macros""}" & vbLf
    s = s & "// → {""t"":""macros_listed"",""id"":""c3"",""macros"":[" & vbLf
    s = s & "//      {""module"":""modSales"",""kind"":""sub"",""name"":""BuildReport"",""args"":""year As Long, qtr As String"",""public"":true}," & vbLf
    s = s & "//      ...]}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "### Refresh data and verify" & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""refresh_connection"",""name"":""OrdersDB""}" & vbLf
    s = s & "// → {""t"":""connection_refreshed"",""id"":""c1"",""name"":""OrdersDB"",""duration_ms"":4200}" & vbLf
    s = s & "// OR if it failed:" & vbLf
    s = s & "// → {""t"":""connection_failed"",""id"":""c1"",""name"":""OrdersDB"",""error"":""Login failed for user 'svc_acct'""}" & vbLf
    s = s & "" & vbLf
    s = s & "{""id"":""c2"",""cmd"":""calculate""}" & vbLf
    s = s & "// → {""t"":""calculated"",""id"":""c2"",""duration_ms"":1820}" & vbLf
    s = s & "" & vbLf
    s = s & "{""id"":""c3"",""cmd"":""read_range"",""sheet"":""Summary"",""range"":""B12""}" & vbLf
    s = s & "// → {""t"":""range_read"",""id"":""c3"",""sheet"":""Summary"",""range"":""B12"",""rows"":[[1247.5]]}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "### Scaffold inputs for a scenario" & vbLf
    s = s & "" & vbLf
    s = s & "`write_range` writes a 2D array of values to a sheet — useful for" & vbLf
    s = s & "setting up test inputs or scenario assumptions:" & vbLf
    s = s & "" & vbLf
    s = s & "```jsonc" & vbLf
    s = s & "{""id"":""c1"",""cmd"":""write_range"",""sheet"":""Inputs"",""range"":""A1""," & vbLf
    s = s & " ""values"":[[""Period"",""Value""],[""Q1"",100],[""Q2"",120],[""Q3"",95]]}" & vbLf
    s = s & "// → {""t"":""range_written"",""id"":""c1"",""sheet"":""Inputs"",""range"":""A1:B4"",""rows"":4,""cols"":2}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "Single-cell anchor (`A1`) auto-resizes to the input dimensions." & vbLf
    s = s & "" & vbLf
    s = s & "## When NOT to use the harness" & vbLf
    s = s & "" & vbLf
    s = s & "- **Pure source edits** that don't need execution — use vba-sync's" & vbLf
    s = s & "  Import (faster, no session overhead)." & vbLf
    s = s & "- **SharePoint-hosted workbooks** that open from a URL — the harness" & vbLf
    s = s & "  works only against local or synced files." & vbLf
    s = s & "- **Reading/writing cell *formatting*** (fill, font, borders) — the" & vbLf
    s = s & "  harness exposes values and formulas only. For formatting use VBA" & vbLf
    s = s & "  inside the workbook." & vbLf
    s = s & "- **Driving the ribbon or menus** — out of scope. Dialogs and" & vbLf
    s = s & "  UserForms triggered by code are in scope." & vbLf
    s = s & "" & vbLf
    s = s & "## Anti-patterns (will cause headaches)" & vbLf
    s = s & "" & vbLf
    s = s & "- **Don't open the workbook manually in Excel** while a session has it" & vbLf
    s = s & "  open — file lock conflict." & vbLf
    s = s & "- **Always send `close`** before killing the session process; otherwise" & vbLf
    s = s & "  Excel may flag the .xlsm as ""needing recovery"" on next open." & vbLf
    s = s & "- **Don't modify .bas files on disk** while a session is live without a" & vbLf
    s = s & "  follow-up `sync_vba` — the in-memory VBA project diverges from disk." & vbLf
    s = s & "- **Don't open the same workbook twice** — use one session per" & vbLf
    s = s & "  workbook (multi-workbook within a session is fine via" & vbLf
    s = s & "  `open_workbook` / `close_workbook`)." & vbLf
    s = s & "" & vbLf
    s = s & "## Debugging stuck or unhappy sessions" & vbLf
    s = s & "" & vbLf
    s = s & "Look at `tools/sessions/<id>/state.json`:" & vbLf
    s = s & "" & vbLf
    s = s & "```json" & vbLf
    s = s & "{" & vbLf
    s = s & "  ""pid"": 12345," & vbLf
    s = s & "  ""workbook"": ""C:\\path\\X.xlsm""," & vbLf
    s = s & "  ""session_id"": ""s1""," & vbLf
    s = s & "  ""status"": ""busy""," & vbLf
    s = s & "  ""started_at"": ""2026-05-19T10:30:00Z""," & vbLf
    s = s & "  ""last_command_offset"": 482" & vbLf
    s = s & "}" & vbLf
    s = s & "```" & vbLf
    s = s & "" & vbLf
    s = s & "- `status: ready` — idle, waiting for commands" & vbLf
    s = s & "- `status: busy` — executing a command (likely run_macro)" & vbLf
    s = s & "- `status: closed` — clean shutdown" & vbLf
    s = s & "- `status: crashed` — host died unexpectedly; check `events.jsonl`" & vbLf
    s = s & "  tail for `session_error`" & vbLf
    s = s & "" & vbLf
    s = s & "**Session hangs (no events arriving):**" & vbLf
    s = s & "1. Check `state.json` — if `status: busy` for a long time, the macro" & vbLf
    s = s & "   is probably stuck on a modal you haven't responded to. Look at the" & vbLf
    s = s & "   last `dialog_appeared` / `userform_appeared` event — does it" & vbLf
    s = s & "   have a `dialog_id` you should respond to?" & vbLf
    s = s & "2. If the dialog is something unexpected (e.g., Excel's ""file recovery""" & vbLf
    s = s & "   dialog from a prior crash), screenshot the host's main window via" & vbLf
    s = s & "   `{""id"":""cN"",""cmd"":""screenshot"",""target"":""window""}` to see what's" & vbLf
    s = s & "   on screen." & vbLf
    s = s & "3. Last resort: if no response to commands at all and PID is alive" & vbLf
    s = s & "   but unresponsive, terminate the PID (NOT all of Excel) and start a" & vbLf
    s = s & "   fresh session." & vbLf
    s = s & "" & vbLf
    s = s & "**Commands not being processed:**" & vbLf
    s = s & "- `commands.jsonl` is read by byte offset (tracked in" & vbLf
    s = s & "  `state.last_command_offset`). If you accidentally rewrote the file" & vbLf
    s = s & "  instead of appending, the harness may skip your new commands or" & vbLf
    s = s & "  re-read old ones. Always **append**, never overwrite." & vbLf
    s = s & "" & vbLf
    s = s & "**`macro_failed` with cryptic COM error:**" & vbLf
    s = s & "- Look for a paired `runtime_error` event preceding it — that's the" & vbLf
    s = s & "  real VBA error number and description. The `macro_failed` HRESULT" & vbLf
    s = s & "  is COM's translation of the same." & vbLf
    s = s & "" & vbLf
    s = s & "**`respond_dialog` returns `respond_failed`:**" & vbLf
    s = s & "- `unknown_or_closed_dialog` — the dialog vanished before your command" & vbLf
    s = s & "  arrived (user clicked it, or another macro closed it). Watch for" & vbLf
    s = s & "  `dialog_closed_externally` events." & vbLf
    s = s & "- `dialog_did_not_close` — the watcher's click dispatch chain" & vbLf
    s = s & "  (WM_COMMAND → BM_CLICK → VK_RETURN → WM_CLOSE) failed. Rare." & vbLf
    s = s & "  Screenshot the dialog and report." & vbLf
    s = s & "" & vbLf
    s = s & "## Known limitations" & vbLf
    s = s & "" & vbLf
    s = s & "- **`Debug.Print` capture** — in headless Excel COM, `Debug.Print`" & vbLf
    s = s & "  output doesn't surface in `VBE.Windows(""Immediate"").CodePane`. The" & vbLf
    s = s & "  capture code is in place but yields no events. Use a custom file" & vbLf
    s = s & "  logger if you need runtime output:" & vbLf
    s = s & "" & vbLf
    s = s & "  ```vba" & vbLf
    s = s & "  Public Sub Log(s As String)" & vbLf
    s = s & "      Open ThisWorkbook.Path & ""\macro.log"" For Append As #1" & vbLf
    s = s & "      Print #1, Format(Now, ""hh:nn:ss.000""); "" ""; s" & vbLf
    s = s & "      Close #1" & vbLf
    s = s & "  End Sub" & vbLf
    s = s & "  ```" & vbLf
    s = s & "" & vbLf
    s = s & "- **UserForm field introspection** — modal UserForm `Controls(name).Value`" & vbLf
    s = s & "  isn't reachable from outside the VBA runtime. `respond_dialog` fires" & vbLf
    s = s & "  the form's Default button via VK_RETURN. For forms with input" & vbLf
    s = s & "  fields, either (a) wrap the form-show in a VBA Sub that pre-fills" & vbLf
    s = s & "  fields, or (b) take a screenshot via `screenshot target=form:<id>`" & vbLf
    s = s & "  and read it visually." & vbLf
    s = s & "" & vbLf
    s = s & "- **`.frx` non-determinism** — Excel's UserForm binary writer is" & vbLf
    s = s & "  non-deterministic; .frx files differ between consecutive saves" & vbLf
    s = s & "  even when the form hasn't changed. Tracked separately." & vbLf
    s = s & "" & vbLf
    s = s & "## Reference" & vbLf
    s = s & "" & vbLf
    s = s & "Full command and event reference: [tools/INTERFACE.md](../../../tools/INTERFACE.md)" & vbLf
    s = s & "" & vbLf
    s = s & "Source: [excel-control](https://github.com/ecsapp/vba-sync/tree/main/excel-control) in the vba-sync repo." & vbLf
    GetSkillMd = s
End Function

