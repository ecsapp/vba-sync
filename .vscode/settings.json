{
  // Auto-generated by VBA Sync. VBA exports are in the system ANSI
  // codepage; these per-language overrides tell VS Code to read VBA
  // files in that codepage so non-ASCII characters render correctly.
  // autoGuessEncoding is disabled because pure-ASCII files (most VBA
  // modules) parse cleanly as UTF-8 and the guesser will override
  // our setting. Other file types (README.md, .json, .xml) keep VS
  // Code defaults so emojis and UTF-8 content render correctly.
  "files.autoGuessEncoding": false,
  "files.associations": {
    "*.bas": "vba",
    "*.cls": "vba",
    "*.frm": "vba"
  },
  "[vba]": { "files.encoding": "windows1252" }
}
