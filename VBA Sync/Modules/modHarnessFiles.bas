    s = s & "" & vbLf
    s = s & "        function Read-RespondCommands {" & vbLf
    s = s & "            $out = New-Object System.Collections.ArrayList" & vbLf
    s = s & "            if (-not (Test-Path $state.CommandsFile)) { return $out }" & vbLf
    s = s & "            $fs = [System.IO.File]::Open($state.CommandsFile, 'Open', 'Read', 'ReadWrite')" & vbLf
    s = s & "            try {" & vbLf
    s = s & "                if ($state.CmdOffset -gt $fs.Length) { $state.CmdOffset = 0 }" & vbLf
    s = s & "                $fs.Position = $state.CmdOffset" & vbLf
    s = s & "                $sr = New-Object System.IO.StreamReader($fs, [System.Text.Encoding]::UTF8, $true, 1024, $true)" & vbLf
    s = s & "                while (-not $sr.EndOfStream) {" & vbLf
    s = s & "                    $line = $sr.ReadLine()" & vbLf
    s = s & "                    if ($null -eq $line) { break }" & vbLf
    s = s & "                    $trim = $line.Trim()" & vbLf
    s = s & "                    if ($trim) {" & vbLf
    s = s & "                        try {" & vbLf
    s = s & "                            $obj = $trim | ConvertFrom-Json" & vbLf
    s = s & "                            if ($obj.cmd -eq 'respond_dialog') { [void]$out.Add($obj) }" & vbLf
    s = s & "                        } catch {}" & vbLf
    s = s & "                    }" & vbLf
    s = s & "                }" & vbLf
    s = s & "                $state.CmdOffset = $fs.Position" & vbLf
    s = s & "                $sr.Dispose()" & vbLf
    s = s & "            } finally { $fs.Dispose() }" & vbLf
    s = s & "            return $out" & vbLf
    s = s & "        }" & vbLf
    s = s & "" & vbLf
    s = s & "        function Send-DialogClick($dialogInfo, [string]$buttonLabel) {" & vbLf
    s = s & "            $hwnd = [IntPtr]$dialogInfo.Hwnd" & vbLf
    s = s & "            $target = $null" & vbLf
    s = s & "            foreach ($b in $dialogInfo.Buttons) {" & vbLf
    s = s & "                if ($b.Caption.Trim().ToLower() -eq $buttonLabel.ToLower()) { $target = $b; break }" & vbLf
    s = s & "            }" & vbLf
    s = s & "            $closed = $false" & vbLf
    s = s & "            if ($target) {" & vbLf
    s = s & "                $ctrlId = [XcDialog.Win32]::GetDlgCtrlID([IntPtr]$target.Hwnd)" & vbLf
    s = s & "                if ($ctrlId -ne 0) {" & vbLf
    s = s & "                    [XcDialog.Win32]::PostMessage($hwnd, [XcDialog.Win32]::WM_COMMAND, [IntPtr]$ctrlId, [IntPtr]$target.Hwnd) | Out-Null" & vbLf
    s = s & "                    $closed = Wait-Closed -h $hwnd -timeoutMs 800" & vbLf
    s = s & "                }" & vbLf
    s = s & "                if (-not $closed) {" & vbLf
    s = s & "                    [XcDialog.Win32]::PostMessage([IntPtr]$target.Hwnd, [XcDialog.Win32]::BM_CLICK, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null" & vbLf
    s = s & "                    $closed = Wait-Closed -h $hwnd -timeoutMs 800" & vbLf
    s = s & "                }" & vbLf
    s = s & "            }" & vbLf
    s = s & "            if (-not $closed) {" & vbLf
    s = s & "                # UserForm with Forms.CommandButton — VK_RETURN fires Default click handler" & vbLf
    s = s & "                [XcDialog.Win32]::PostMessage($hwnd, [XcDialog.Win32]::WM_KEYDOWN, [IntPtr][XcDialog.Win32]::VK_RETURN, [IntPtr]0) | Out-Null" & vbLf
    s = s & "                [XcDialog.Win32]::PostMessage($hwnd, [XcDialog.Win32]::WM_KEYUP,   [IntPtr][XcDialog.Win32]::VK_RETURN, [IntPtr]0) | Out-Null" & vbLf
    s = s & "                $closed = Wait-Closed -h $hwnd -timeoutMs 1200" & vbLf
    s = s & "            }" & vbLf
    s = s & "            if (-not $closed) {" & vbLf
    s = s & "                [XcDialog.Win32]::PostMessage($hwnd, [XcDialog.Win32]::WM_CLOSE, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null" & vbLf
    s = s & "                $closed = Wait-Closed -h $hwnd -timeoutMs 800" & vbLf
    s = s & "            }" & vbLf
    s = s & "            return $closed" & vbLf
    s = s & "        }" & vbLf
    s = s & "" & vbLf
    s = s & "        # ---- main loop ----" & vbLf
    s = s & "        while (-not $state.Stop) {" & vbLf
    s = s & "            $dialogs = Find-Dialogs -targetPid $state.ProcessId" & vbLf
    s = s & "            $stillActive = @{}" & vbLf
    s = s & "            foreach ($d in $dialogs) { $stillActive[([IntPtr]$d).ToInt64()] = $true }" & vbLf
    s = s & "" & vbLf
    s = s & "            # New dialogs" & vbLf
    s = s & "            foreach ($d in $dialogs) {" & vbLf
    s = s & "                $hwnd = [IntPtr]$d" & vbLf
    s = s & "                $key  = $hwnd.ToInt64()" & vbLf
    s = s & "                if ($state.ActiveDialogs.ContainsKey($key)) { continue }" & vbLf
    s = s & "" & vbLf
    s = s & "                $caption = Get-WText -h $hwnd" & vbLf
    s = s & "                $cls     = Get-WClass -h $hwnd" & vbLf
    s = s & "                $payload = Get-Payload -dlg $hwnd" & vbLf
    s = s & "" & vbLf
    s = s & "                $id = ""d$($state.NextId)""" & vbLf
    s = s & "                $state.NextId++" & vbLf
    s = s & "                $state.ActiveDialogs[$key] = $id" & vbLf
    s = s & "                $state.DialogInfo[$id] = [pscustomobject]@{" & vbLf
    s = s & "                    Hwnd    = $hwnd.ToInt64()" & vbLf
    s = s & "                    Buttons = $payload.Buttons" & vbLf
    s = s & "                    Caption = $caption" & vbLf
    s = s & "                }" & vbLf
    s = s & "" & vbLf
    s = s & "                $buttonNames = @($payload.Buttons | ForEach-Object { $_.Caption })" & vbLf
    s = s & "                # Classify the dialog. VBA's ""Microsoft Visual Basic""" & vbLf
    s = s & "                # runtime-error dialog has buttons &Continue / &End /" & vbLf
    s = s & "                # &Debug / &Help. We turn it into a structured" & vbLf
    s = s & "                # `runtime_error` event AND auto-dispatch End (the macro" & vbLf
    s = s & "                # is unrecoverable from outside)." & vbLf
    s = s & "                #" & vbLf
    s = s & "                # Detection: caption == ""Microsoft Visual Basic"" is the" & vbLf
    s = s & "                # strong signal — works for any error format including" & vbLf
    s = s & "                # negative codes (vbObjectError-based) and the" & vbLf
    s = s & "                # ""N (hexcode)"" rendering of those." & vbLf
    s = s & "                $isRtError = ($caption -eq 'Microsoft Visual Basic')" & vbLf
    s = s & "                $rtNum  = 0" & vbLf
    s = s & "                $rtDesc = $payload.Body" & vbLf
    s = s & "                if ($isRtError -and $payload.Body -match ""Run-time error '(-?\d+)(?:\s*\([0-9A-Fa-f]+\))?'\s*[:\.]?\s*(.*)$"") {" & vbLf
    s = s & "                    $rtNum  = [int64]$Matches[1]" & vbLf
    s = s & "                    $rtDesc = $Matches[2].Trim()" & vbLf
    s = s & "                }" & vbLf
    s = s & "                $eventType =" & vbLf
    s = s & "                    if ($isRtError) { 'runtime_error' }" & vbLf
    s = s & "                    elseif ($cls -eq 'ThunderDFrame' -or $cls -like 'F3*' -or $cls -like 'bosa*') { 'userform_appeared' }" & vbLf
    s = s & "                    else { 'dialog_appeared' }" & vbLf
    s = s & "" & vbLf
    s = s & "                $shotPath = $null" & vbLf
    s = s & "                $shotErr  = $null" & vbLf
    s = s & "                try {" & vbLf
    s = s & "                    $shotPath = Join-Path $state.CapturesDir ""$id.png""" & vbLf
    s = s & "                    [void](Save-DialogPng -Hwnd $hwnd.ToInt64() -Path $shotPath)" & vbLf
    s = s & "                    if (-not (Test-Path $shotPath)) { $shotPath = $null; $shotErr = 'png not written' }" & vbLf
    s = s & "                } catch { $shotPath = $null; $shotErr = $_.Exception.Message }" & vbLf
    s = s & "" & vbLf
    s = s & "                $ev = @{" & vbLf
    s = s & "                    t = $eventType" & vbLf
    s = s & "                    id = $id" & vbLf
    s = s & "                    title = $caption" & vbLf
    s = s & "                    text = $payload.Body" & vbLf
    s = s & "                    buttons = $buttonNames" & vbLf
    s = s & "                    class = $cls" & vbLf
    s = s & "                    screenshot = $shotPath" & vbLf
    s = s & "                }" & vbLf
    s = s & "                if ($shotErr) { $ev.screenshot_error = $shotErr }" & vbLf
    s = s & "                if ($isRtError) {" & vbLf
    s = s & "                    $ev.number = $rtNum" & vbLf
    s = s & "                    $ev.description = $rtDesc" & vbLf
    s = s & "                }" & vbLf
    s = s & "                Write-SessionEvent $ev" & vbLf
    s = s & "" & vbLf
    s = s & "                # For runtime errors, immediately dispatch End so the macro" & vbLf
    s = s & "                # returns to COM and PowerShell unblocks. The agent can't" & vbLf
    s = s & "                # respond to a runtime-error mid-macro anyway." & vbLf
    s = s & "                if ($isRtError) {" & vbLf
    s = s & "                    $info = $state.DialogInfo[$id]" & vbLf
